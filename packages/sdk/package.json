{
  "name": "@kamilklasa/paymentic-sdk-node",
  "version": "0.1.0",
  "description": "Unofficial Paymentic SDK for Node.js",
  "keywords": [
    "blik",
    "nodejs",
    "paymentic",
    "payments",
    "sdk",
    "typescript",
    "webhooks"
  ],
  "homepage": "https://github.com/kamilklasa/paymentic-sdk-node#readme",
  "bugs": {
    "url": "https://github.com/kamilklasa/paymentic-sdk-node/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamilklasa/paymentic-sdk-node.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
